CREATE DATABASE MarketDB;
USE MarketDB;

CREATE TABLE Products (
    Product_ID INT PRIMARY KEY,
    Store_Name VARCHAR(100) NOT NULL,
    Item_Name VARCHAR(100) NOT NULL,
    Cost DECIMAL(10,2) DEFAULT 10.00
);

